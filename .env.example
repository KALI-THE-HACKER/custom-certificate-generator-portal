# ==============================================================================
# Email Verification & SMTP Settings
# ==============================================================================

# Enable or disable OTP email verification (true / false)
EMAIL_VERIFICATION_ENABLED=true

# When true, OTPs are also printed to the server console for easy local testing
EMAIL_DEBUG=true

# SMTP Server Host (e.g. smtp.gmail.com, smtp.zoho.in, smtp.office365.com)
SMTP_HOST=smtp.gmail.com

# SMTP Port: 587 (STARTTLS) or 465 (SSL)
SMTP_PORT=587

# Enable STARTTLS (set to true for port 587, false for port 465 SSL)
SMTP_USE_TLS=true

# SMTP Username (usually your email address)
SMTP_USER=your_email@gmail.com

# SMTP App Password (NOT your regular account password)
# For Gmail: Google Account -> Security -> 2-Step Verification -> App passwords
# For Zoho: Account -> Security -> App Passwords
SMTP_PASSWORD=your_16_char_app_password

# Display Name for outgoing emails
SMTP_FROM_NAME="Silicon Maze Team"

# Sender email address (defaults to SMTP_USER if empty)
SMTP_FROM_EMAIL=your_email@gmail.com

# OTP expiration in minutes (default: 10)
OTP_EXPIRY_MINUTES=10

# Minimum seconds before allowing user to resend an OTP (default: 60)
OTP_COOLDOWN_SECONDS=60
